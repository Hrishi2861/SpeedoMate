<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0A0A">

    <!-- Analog + Digital Speedometer -->
    <com.speedomate.ui.SpeedometerView
            android:id="@+id/speedometerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintBottom_toTopOf="@id/statsCard"/>

    <!-- Stats Card with Glassmorphism -->
    <androidx.cardview.widget.CardView
            android:id="@+id/statsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/btnRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stats_card_glass"
                android:padding="16dp">

            <!-- Max / Avg / Distance row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <!-- Max Speed -->
                <LinearLayout
                        android:id="@+id/sectionMaxSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/divider1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                        <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_car"
                                android:layout_marginEnd="4dp"
                                android:alpha="0.6"/>
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAX"
                                android:textSize="10sp"
                                android:textColor="#666666"
                                android:letterSpacing="0.2"
                                android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvMaxSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="monospace"
                            android:layout_marginTop="4dp"/>

                    <TextView
                            android:id="@+id/tvMaxUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="km/h"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:alpha="0.8"/>
                </LinearLayout>

                <!-- Divider 1 -->
                <View
                        android:id="@+id/divider1"
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_marginVertical="8dp"
                        android:background="#1AFFFFFF"
                        app:layout_constraintStart_toEndOf="@id/sectionMaxSpeed"
                        app:layout_constraintEnd_toStartOf="@id/sectionAvgSpeed"
                        app:layout_constraintTop_toTopOf="@id/sectionMaxSpeed"
                        app:layout_constraintBottom_toBottomOf="@id/sectionMaxSpeed"/>

                <!-- Avg Speed -->
                <LinearLayout
                        android:id="@+id/sectionAvgSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        app:layout_constraintStart_toEndOf="@id/divider1"
                        app:layout_constraintEnd_toStartOf="@id/divider2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                        <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_average"
                                android:layout_marginEnd="4dp"
                                android:alpha="0.6"/>
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AVG"
                                android:textSize="10sp"
                                android:textColor="#666666"
                                android:letterSpacing="0.2"
                                android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvAvgSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="monospace"
                            android:layout_marginTop="4dp"/>

                    <TextView
                            android:id="@+id/tvAvgUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="km/h"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:alpha="0.8"/>
                </LinearLayout>

                <!-- Divider 2 -->
                <View
                        android:id="@+id/divider2"
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_marginVertical="8dp"
                        android:background="#1AFFFFFF"
                        app:layout_constraintStart_toEndOf="@id/sectionAvgSpeed"
                        app:layout_constraintEnd_toStartOf="@id/sectionTrip"
                        app:layout_constraintTop_toTopOf="@id/sectionAvgSpeed"
                        app:layout_constraintBottom_toBottomOf="@id/sectionAvgSpeed"/>

                <!-- Trip Distance -->
                <LinearLayout
                        android:id="@+id/sectionTrip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        app:layout_constraintStart_toEndOf="@id/divider2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                        <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_pin"
                                android:layout_marginEnd="4dp"
                                android:alpha="0.6"/>
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TRIP"
                                android:textSize="10sp"
                                android:textColor="#666666"
                                android:letterSpacing="0.2"
                                android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvTrip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textSize="28sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="monospace"
                            android:layout_marginTop="4dp"/>

                    <TextView
                            android:id="@+id/tvTripUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="km"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:alpha="0.8"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Button Row with Icon Buttons -->
    <LinearLayout
            android:id="@+id/btnRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <!-- Top row: Save+Reset and Discard -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnResetTrip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="SAVE + RESET"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#00E5FF"
                    android:letterSpacing="0.05"
                    android:drawableStart="@drawable/ic_save_cyan"
                    android:drawablePadding="8dp"
                    android:background="@drawable/btn_primary_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDiscardTrip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="DISCARD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF4444"
                    android:letterSpacing="0.05"
                    android:drawableStart="@drawable/ic_delete_red"
                    android:drawablePadding="8dp"
                    android:background="@drawable/btn_danger_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

        </LinearLayout>

        <!-- Bottom row: Trip History and Settings -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTripHistory"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="TRIP HISTORY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#AAAAAA"
                    android:letterSpacing="0.05"
                    android:drawableStart="@drawable/ic_history_gray"
                    android:drawablePadding="8dp"
                    android:background="@drawable/btn_secondary_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="SETTINGS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:letterSpacing="0.05"
                    android:drawableStart="@drawable/ic_settings_dim"
                    android:drawablePadding="8dp"
                    android:background="@drawable/btn_secondary_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
