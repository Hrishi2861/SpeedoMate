<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_background"
        android:padding="20dp">

    <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 SpeedoMate"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:letterSpacing="0.1"/>

    <TextView
            android:id="@+id/widget_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="86sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp"/>

    <TextView
            android:id="@+id/widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km/h"
            android:textColor="#00E5FF"
            android:textSize="18sp"/>

    <!-- Divider as TextView instead of View -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A1A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text=""/>

    <!-- Stats Row -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAX"
                    android:textColor="#555555"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"/>
            <TextView
                    android:id="@+id/widget_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="monospace"/>
            <TextView
                    android:id="@+id/widget_max_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG"
                    android:textColor="#555555"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"/>
            <TextView
                    android:id="@+id/widget_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="monospace"/>
            <TextView
                    android:id="@+id/widget_avg_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRIP"
                    android:textColor="#555555"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"/>
            <TextView
                    android:id="@+id/widget_trip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="monospace"/>
            <TextView
                    android:id="@+id/widget_trip_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Divider as TextView -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A1A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text=""/>

    <!-- Buttons Row -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <TextView
                android:id="@+id/widget_btn_save"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="💾 Save+Reset"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:gravity="center"
                android:background="@drawable/widget_btn_background"/>

        <TextView
                android:id="@+id/widget_btn_discard"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🗑 Discard"
                android:textColor="#FF4444"
                android:textSize="11sp"
                android:gravity="center"
                android:background="@drawable/widget_btn_background"/>

    </LinearLayout>

    <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to start"
            android:textColor="#444444"
            android:textSize="10sp"
            android:layout_marginTop="8dp"/>

</LinearLayout>